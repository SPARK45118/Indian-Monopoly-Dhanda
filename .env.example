# =========================================
# DHANDHA — Environment Variables Template
# Copy this to packages/server/.env
# =========================================

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://dhandha:dhandha_secret@localhost:5432/dhandha

# Redis (Docker Compose defaults)
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret-in-production

# CORS (client origin)
CORS_ORIGIN=http://localhost:5173

# AI (Phase 5 — leave empty for Phase 1, features will be mocked)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =========================================
# packages/client — create a .env file with:
# VITE_SERVER_URL=http://localhost:3001
# =========================================
